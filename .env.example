# DATABASE: server-only. Copy Direct or Session URL from Supabase Connect; no hostname assumed.
# TLS defaults to full certificate/hostname verification. No secret is required for build/tests.
DATABASE_URL=
DATABASE_POOL_MAX=5
# Optional CA from Supabase; use PEM secret in Coolify OR local file path, not both.
DATABASE_SSL_CA_PEM=
DATABASE_SSL_CA_FILE=

# SUPABASE: reserved for future Auth/admin integration; currently unused.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# MQTT: production ingestor uses the internal Docker name; external devices use public DNS.
# Leave INTERNAL/PUBLIC empty for local Node; MQTT_HOST is the backward-compatible local fallback.
MQTT_INTERNAL_HOST=
MQTT_PUBLIC_HOST=
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_PROTOCOL=mqtt
MQTT_USERNAME=ingestor
MQTT_PASSWORD=CHANGE_ME
MQTT_SIMULATOR_USERNAME=simulator
MQTT_SIMULATOR_PASSWORD=CHANGE_ME
MQTT_CA_FILE=
MQTT_DISCOVERY_MODE=false
MQTT_TOPIC_FILTER=iiot/+/+/+/telemetry,data/POC/group1/A7-001
MQTT_CLIENT_ID=everlenz-ingestor
MQTT_TLS_CERT_DIR=
# Production binds both TCP ports. Restrict 1883 by VPS/Docker-aware firewall before starting.
MQTT_TCP_BIND_ADDRESS=0.0.0.0
MQTT_TLS_BIND_ADDRESS=0.0.0.0
SIMULATOR_INTERVAL_MS=2000
DEVICE_OFFLINE_SECONDS=30

# API: no platform authentication yet. Protect HTTP access at the proxy/VPN.
API_PORT=3001
DEV_TENANT_ID=11111111-1111-4111-8111-111111111111
OPERATOR_RAW_ACCESS=false
INGESTOR_HEALTH_PORT=3002
INGESTOR_HEALTH_URL=http://127.0.0.1:3002/health

# WEB: same-origin /api proxy. Domains are Coolify configuration inputs, never hardcoded.
API_INTERNAL_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=/api
IIOT_WEB_DOMAIN=
IIOT_API_DOMAIN=
WEB_PORT=3000

# OPTIONAL LOCAL POSTGRES: only docker-compose.yml --profile development, never production.
# pnpm env:setup --local creates DATABASE_URL for the local host.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=iiot
POSTGRES_USER=iiot
POSTGRES_PASSWORD=CHANGE_ME
MQTT_BIND_ADDRESS=127.0.0.1
